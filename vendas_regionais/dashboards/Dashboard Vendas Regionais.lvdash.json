{
  "datasets": [
    {
      "name": "vendas_base_completa",
      "displayName": "Vendas Base Completa",
      "queryLines": [
        "SELECT\n",
        "  data_venda,\n",
        "  mes_abrev,\n",
        "  regiao,\n",
        "  vendedor,\n",
        "  codigo_vendedor,\n",
        "  secao,\n",
        "  valor_vendas,\n",
        "  ano,\n",
        "  mes\n",
        "FROM\n",
        "  workspace.vendas_regionais.vendas_base\n",
        "ORDER BY\n",
        "  ano,\n",
        "  mes"
      ],
      "columns": [
        {
          "displayName": "Ordem Mês",
          "description": "Ordem numérica dos meses para ordenação cronológica",
          "expression": "CASE `mes_abrev`\n  WHEN 'JAN' THEN 1\n  WHEN 'FEV' THEN 2\n  WHEN 'MAR' THEN 3\n  WHEN 'ABR' THEN 4\n  WHEN 'MAI' THEN 5\n  WHEN 'JUN' THEN 6\n  WHEN 'JUL' THEN 7\n  WHEN 'AGO' THEN 8\n  WHEN 'SET' THEN 9\n  WHEN 'OUT' THEN 10\n  WHEN 'NOV' THEN 11\n  WHEN 'DEZ' THEN 12\n  ELSE 0\nEND"
        },
        {
          "displayName": "Mês Ordenado",
          "description": "Mês com prefixo numérico para ordenação cronológica",
          "expression": "CONCAT(LPAD(CAST(`mes` AS STRING), 2, '0'), '_', `mes_abrev`)"
        },
        {
          "displayName": "Trimestre",
          "description": "Classificação trimestral baseada no mês (Q1, Q2, Q3, Q4)",
          "expression": "CASE \n  WHEN `mes` IN (1, 2, 3) THEN 'Q1'\n  WHEN `mes` IN (4, 5, 6) THEN 'Q2'\n  WHEN `mes` IN (7, 8, 9) THEN 'Q3'\n  WHEN `mes` IN (10, 11, 12) THEN 'Q4'\n  ELSE 'Desconhecido'\nEND"
        }
      ]
    }
  ],
